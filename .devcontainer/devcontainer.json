{
    "name": "Hermes Dev",
    "dockerComposeFile": "docker-compose.yml",
    "service": "app",
    "workspaceFolder": "/workspaces/hermes-multiagent-runtime",
    "remoteUser": "vscode",
    "remoteEnv": {
        "HERMES_TEST_DATABASE_URL": "postgresql+psycopg://postgres:postgres@postgres:5432/hermes_test"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "GitHub.copilot",
                "GitHub.copilot-chat",
                "ms-python.python"
            ]
        }
    },
    "postCreateCommand": "python -m pip install -e '.[test]'",
    "features": {}
}