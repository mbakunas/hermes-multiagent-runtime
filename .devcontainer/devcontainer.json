{
    "name": "Hermes Dev",
    "dockerComposeFile": "docker-compose.yml",
    "service": "app",
    "workspaceFolder": "/workspaces/hermes-multiagent-runtime",
    "remoteUser": "vscode",
    "customizations": {
        "vscode": {
            "extensions": [
                "GitHub.copilot",
                "GitHub.copilot-chat",
                "ms-python.python"
            ]
        }
    },
    "postCreateCommand": "python -m pip install -e '.[test]'"
}
